# ============================================================
# socialmediamanager — variabili d'ambiente
# Copia in `.env` (o configura in Vercel → Project → Environment)
# ============================================================

# Database (Postgres).
# Per cloud: crea un progetto gratuito su https://neon.tech e incolla la connection string.
# Per locale: puoi usare Docker `postgres:16` oppure SQLite (cambia provider in prisma/schema.prisma).
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# NextAuth / Auth.js
# Genera con: `openssl rand -base64 32`
AUTH_SECRET="change-me"
# In locale lascia http://localhost:3000 ; in produzione metti l'URL del deploy.
NEXTAUTH_URL="http://localhost:3000"

# Provider di login dell'app (solo per entrare nella dashboard, NON per i social).
# Crea OAuth client su https://console.cloud.google.com
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Chiave di cifratura per i token social salvati a DB.
# Genera con: `openssl rand -hex 32` (deve essere 32 byte esadecimali = 64 caratteri)
TOKEN_ENCRYPTION_KEY=""

# Anthropic API per il motore di raccomandazione.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""

# Secret condiviso per proteggere gli endpoint /api/cron/*
# Vercel Cron invia l'header `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET="change-me"

# ============================================================
# OAuth social (uno per piattaforma). Lasciali vuoti finché non
# crei l'app di sviluppo corrispondente — il connettore rimarrà
# solo "disconnesso" nella UI.
# ============================================================

# Meta (Instagram + Facebook) — https://developers.facebook.com
META_CLIENT_ID=""
META_CLIENT_SECRET=""

# TikTok — https://developers.tiktok.com
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# YouTube (Google) — riusa le credenziali Google qui sotto o crea un client dedicato.
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""

# Spotify — https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
