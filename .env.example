# ============================================================
# socialmediamanager — variabili d'ambiente
# Copia in `.env` (o configura in Vercel → Project → Environment)
# ============================================================

# Database (Postgres).
# Per cloud: crea un progetto gratuito su https://neon.tech e incolla la connection string.
# Per locale: puoi usare Docker `postgres:16` oppure SQLite (cambia provider in prisma/schema.prisma).
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# NextAuth / Auth.js
# Genera con: `openssl rand -base64 32`
AUTH_SECRET="change-me"
# In locale lascia http://localhost:3000 ; in produzione metti l'URL del deploy.
NEXTAUTH_URL="http://localhost:3000"

# Provider di login dell'app E del connettore YouTube.
# Crea UN solo OAuth client su https://console.cloud.google.com con DUE redirect URI:
#   http://localhost:3000/api/auth/callback/google      (login app)
#   http://localhost:3000/api/connect/youtube/callback  (connettore YouTube)
# Abilita anche YouTube Data API v3 + YouTube Analytics API sul progetto.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Chiave di cifratura per i token social salvati a DB.
# Genera con: `openssl rand -hex 32` (deve essere 32 byte esadecimali = 64 caratteri)
TOKEN_ENCRYPTION_KEY=""

# Anthropic API per il motore di raccomandazione.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""

# Allowlist email per il login (consigliato in produzione su Vercel).
# Solo gli indirizzi qui sotto possono accedere all'app via Google.
# Se vuota = accesso libero a chiunque ha un Google account (OK in dev,
# rischioso in prod perché chiunque può consumare il tuo budget Claude).
# Esempio: "tu@gmail.com,collaboratore@gmail.com"
AUTH_ALLOWED_EMAILS=""

# Secret condiviso per proteggere gli endpoint /api/cron/*
# Vercel Cron invia l'header `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET="change-me"

# ============================================================
# OAuth social (uno per piattaforma). Lasciali vuoti finché non
# crei l'app di sviluppo corrispondente — il connettore rimarrà
# solo "disconnesso" nella UI.
# ============================================================

# Meta (Instagram + Facebook) — https://developers.facebook.com
META_CLIENT_ID=""
META_CLIENT_SECRET=""

# TikTok — https://developers.tiktok.com
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# YouTube: NON serve una variabile dedicata, riusiamo AUTH_GOOGLE_ID /
# AUTH_GOOGLE_SECRET sopra. Ricordati di aggiungere il redirect URI
# http://localhost:3000/api/connect/youtube/callback al client OAuth Google.

# Spotify — https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""

# ============================================================
# Notifiche email (opzionali). Se vuote, il cron serale
# scrive il feedback in DB ma non invia email — non blocca
# nulla. Free tier Resend = 3000 email/mese.
# ============================================================
# https://resend.com/api-keys
RESEND_API_KEY=""
# Mittente verificato (es. "SMM Studio <noreply@tuodominio.it>"). Per il dev
# locale puoi usare "onboarding@resend.dev" che Resend permette senza dominio.
EMAIL_FROM=""

# ============================================================
# Calendario sottoscrivibile (opzionale).
# Permette a Google/Apple Calendar di leggere il tuo feed .ics
# senza login. Entrambe le var DEVONO essere impostate insieme;
# se ne manca una, l'endpoint resta accessibile solo con sessione.
# ============================================================
# Token statico (32 caratteri esadecimali). Genera con: openssl rand -hex 16
CALENDAR_FEED_KEY=""
# Tuo `User.id` autorizzato a leggere il feed (hardcoded server-side per
# evitare IDOR). Recuperalo con: pnpm prisma studio → tabella User → copia id
CALENDAR_FEED_OWNER_ID=""
