// socialmediamanager — data model
// Vedi README.md per il comando di setup DB.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---- Auth.js (NextAuth) ----
// Schema standard dell'adattatore Prisma. Non toccare i nomi dei campi.

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  timezone      String    @default("Europe/Rome")

  accounts Account[]
  sessions Session[]
  projects Project[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---- Dominio applicativo ----

enum CreatorKind {
  ARTIST
  YOUTUBER
  INFLUENCER
  DIVULGATORE
  PODCASTER
  BRAND
}

model Project {
  id                   String      @id @default(cuid())
  userId               String
  kind                 CreatorKind
  displayName          String
  niche                String?
  city                 String?
  bio                  String?     @db.Text
  websiteUrl           String?
  emailFeedbackEnabled Boolean     @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  socialAccounts SocialAccount[]
  suggestions    Suggestion[]
  drafts         Draft[]
  brandIdentity  BrandIdentity?
  stageNameIdeas StageNameIdea[]
  neuroScores    NeuroScore[]
  personas       Persona[]
  campaigns      Campaign[]
  goals          Goal[]
  dailyFeedback  DailyFeedback[]
  trends         Trend[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Modulo Brand (M11): identità visiva generata da Claude.
model BrandIdentity {
  id                 String   @id @default(cuid())
  projectId          String   @unique
  palette            Json? // [{ hex, role, usage }, ...]
  typography         Json? // { title: {family, weights, rationale}, body: {...} }
  toneOfVoice        Json? // { adjectives: [...], examples: [...] }
  moodKeywords       String[] // es. ["notturno", "underground", "analogico"]
  logoBrief          String?  @db.Text
  logoSvg            String?  @db.Text // SVG inline generato da Claude
  claudeDesignPrompt String?  @db.Text
  mjPrompt           String?  @db.Text
  coverBriefs        Json? // [{ title, brief, claudeDesignPrompt, mjPrompt, ideogramPrompt }]

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Proposte nome d'arte dal wizard + cache delle check disponibilità handle.
model StageNameIdea {
  id           String  @id @default(cuid())
  projectId    String
  name         String
  rationale    String  @db.Text
  availability Json? // { instagram: "free"|"taken"|"unknown", tiktok: "...", spotify: "..." }
  chosen       Boolean @default(false)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
}

// Feedback giornaliero prodotto dal cron serale. Un record per project+data.
model DailyFeedback {
  id          String   @id @default(cuid())
  projectId   String
  forDate     DateTime // giorno a cui si riferisce (ore 00:00)
  headline    String   @db.Text
  body        String   @db.Text
  postsCount  Int      @default(0)
  generatedBy String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([projectId, forDate])
}

enum Platform {
  INSTAGRAM
  FACEBOOK
  TIKTOK
  YOUTUBE
  SPOTIFY
}

model SocialAccount {
  id              String    @id @default(cuid())
  projectId       String
  platform        Platform
  handle          String // @nome_utente o nome canale
  externalId      String // id stabile restituito dalla piattaforma
  accessTokenEnc  String    @db.Text // cifrato
  refreshTokenEnc String?   @db.Text
  expiresAt       DateTime?
  scopes          String[] // array di scope concessi
  meta            Json? // dati specifici piattaforma (es. pageId per FB, channelId per YT)
  lastSyncedAt    DateTime?
  lastSyncError   String?   @db.Text

  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  metrics          MetricSnapshot[]
  posts            Post[]
  audienceInsights AudienceInsight[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, platform, externalId])
  @@index([projectId, platform])
}

model MetricSnapshot {
  id           String   @id @default(cuid())
  accountId    String
  capturedAt   DateTime @default(now())
  followers    Int?
  following    Int?
  postsCount   Int?
  reach        Int?
  impressions  Int?
  profileViews Int?
  // campi piattaforma-specifici (watch time YT, popularity Spotify, ecc.)
  extra        Json?

  account SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, capturedAt])
}

enum MediaType {
  IMAGE
  VIDEO
  CAROUSEL
  REEL
  STORY
  SHORT
  LIVE
  OTHER
}

model Post {
  id           String    @id @default(cuid())
  accountId    String
  externalId   String
  postedAt     DateTime
  mediaType    MediaType @default(OTHER)
  caption      String?   @db.Text
  permalink    String?
  likes        Int?
  comments     Int?
  shares       Int?
  saves        Int?
  views        Int?
  reach        Int?
  impressions  Int?
  // payload grezzo per metriche specifiche (watch time, CTR, ecc.)
  raw          Json?
  lastSyncedAt DateTime?

  account SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, externalId])
  @@index([accountId, postedAt])
}

model AudienceInsight {
  id           String   @id @default(cuid())
  accountId    String
  capturedAt   DateTime @default(now())
  ageBuckets   Json? // { "13-17": 0.05, "18-24": 0.45, ... }
  genderSplit  Json? // { male: 0.6, female: 0.4, other: 0.0 }
  topCountries Json? // [{ code: "IT", share: 0.88 }, ...]
  topCities    Json?

  account SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, capturedAt])
}

enum ContentType {
  REEL
  CAROUSEL
  SHORT
  POST
  STORY
  TIKTOK
  YT_LONG
}

enum SuggestionStatus {
  PROPOSED
  ACCEPTED
  REJECTED
  EXPIRED
}

model Suggestion {
  id            String           @id @default(cuid())
  projectId     String
  forDate       DateTime
  platform      Platform
  contentType   ContentType
  hook          String           @db.Text
  caption       String           @db.Text
  hashtags      String[]
  cta           String?
  suggestedTime String? // HH:mm in timezone utente
  rationale     String?          @db.Text
  status        SuggestionStatus @default(PROPOSED)
  generatedBy   String? // es. "claude-sonnet-4-6"
  campaignId    String?

  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  draft      Draft?
  campaign   Campaign?   @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  neuroScore NeuroScore?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, forDate])
  @@index([projectId, status])
  @@index([campaignId])
}

enum DraftStatus {
  TODO
  READY
  PUBLISHED
  ARCHIVED
}

model Draft {
  id           String      @id @default(cuid())
  projectId    String
  suggestionId String?     @unique
  platform     Platform
  contentType  ContentType
  scheduledFor DateTime?
  caption      String      @db.Text
  hashtags     String[]
  mediaNotes   String?     @db.Text
  checklist    Json? // [{ text: "Registra 15s in studio", done: false }, ...]
  status       DraftStatus @default(TODO)

  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  suggestion Suggestion? @relation(fields: [suggestionId], references: [id])
  neuroScore NeuroScore?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, status])
  @@index([projectId, scheduledFor])
}

// Modulo Marketing (M12): neuro-score ispirato ai segnali brain-predictive
// del foundation model TRIBE v2 (Meta AI). Implementazione via Claude con
// system prompt che codifica i segnali principali del paper.

model NeuroScore {
  id           String  @id @default(cuid())
  projectId    String
  suggestionId String? @unique
  draftId      String? @unique
  score        Int // 0-100
  breakdown    Json // { hookStrength, emotionalValence, noveltyBias, rewardPrediction, socialSalience, curiosityGap }
  improvements Json // array di 3 stringhe
  generatedBy  String?

  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  suggestion Suggestion? @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  draft      Draft?      @relation(fields: [draftId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([projectId])
}

model Persona {
  id             String   @id @default(cuid())
  projectId      String
  name           String
  ageRange       String
  location       String
  occupation     String
  musicHabits    String   @db.Text
  platforms      String[]
  listeningTimes String?
  triggers       Json // array di trigger che funzionano (es. "drop snippet venerdì sera")
  culturalRefs   Json // array di ref (meme, influencer seguiti)
  generatedBy    String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

enum CampaignType {
  SINGOLO
  EP
  ALBUM
  LIVE
  MERCH
  VIDEO_DROP
  SERIES
  EPISODE
  SPONSOR
  EVENT
  PRODUCT
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Campaign {
  id          String         @id @default(cuid())
  projectId   String
  title       String
  type        CampaignType
  releaseDate DateTime
  preSaveUrl  String?
  goal        String?        @db.Text
  status      CampaignStatus @default(DRAFT)
  generatedBy String?
  details     Json?

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  suggestions Suggestion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, releaseDate])
}

// Obiettivi tracciabili nel tempo (es. "10k follower IG entro il 31/12").
// La progressione si calcola correlando questo record con MetricSnapshot del
// SocialAccount corrispondente per la piattaforma indicata.
enum GoalMetric {
  FOLLOWERS
  AVG_VIEWS
  AVG_REACH
  MONTHLY_LISTENERS
}

enum GoalStatus {
  ACTIVE
  ACHIEVED
  EXPIRED
  ARCHIVED
}

model Goal {
  id          String     @id @default(cuid())
  projectId   String
  platform    Platform
  metric      GoalMetric
  targetValue Int
  targetDate  DateTime?
  startValue  Int        @default(0)
  startedAt   DateTime   @default(now())
  achievedAt  DateTime?
  status      GoalStatus @default(ACTIVE)
  note        String?    @db.Text

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, status])
  @@index([projectId, platform])
}

// Trend Library (M18) — sound/format/topic in voga, manuali o suggeriti da Claude.
enum TrendKind {
  SOUND
  FORMAT
  TOPIC
  HASHTAG
  CHALLENGE
}

enum TrendStatus {
  ACTIVE
  WARMING
  EXPIRED
}

model Trend {
  id          String      @id @default(cuid())
  projectId   String
  kind        TrendKind
  name        String
  description String?     @db.Text
  sourceUrl   String?
  platforms   Platform[]
  status      TrendStatus @default(ACTIVE)
  notedAt     DateTime    @default(now())
  expiresAt   DateTime?
  generatedBy String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, status])
  @@index([projectId, kind])
}
